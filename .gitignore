# 权重文件太大，不进 Git（任务书要求排除）
*.pt
weights/
*.part

# 例外：自己训练出来的 best.pt 要跟着源码走，必须提交
!model/best.pt

# 选图时下的临时候选图与 COCO 标注缓存（都能用 fetch_coco.py 重新生成）
data/_cand/
data/_cache/

# Python 缓存
__pycache__/
*.pyc

# 原始图片压缩包
data/raw/*.zip
data/raw/*.tar.gz

# 运行时产物
data/preview/
records/drafts/

# 刻意不忽略：records/annotations/ 与 records/fixes.jsonl
# 这两样是「人工标注成果」和「修正流水账」，是评分要看的东西，必须进仓库

# 训练输出
runs/
dataset/

# 人员打卡：逐帧 JPEG + 结果 mp4（164 MB，随时可重新生成）
data/track/

# 交付打包产物（体积大，单独发送给评委）
dist/

# 打卡流水（运行产物）
records/checkin_log.jsonl
